{
  "description": "Agent Coach lifecycle bridge",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-entry.mjs\" --host codex",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\hook-entry.mjs\" --host codex",
            "timeout": 3,
            "additionalContextLimit": 1200,
            "statusMessage": "Starting Agent Coach trace"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-entry.mjs\" --host codex",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\hook-entry.mjs\" --host codex",
            "timeout": 2,
            "additionalContextLimit": 1200,
            "statusMessage": "Checking Agent Coach epoch"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-entry.mjs\" --host codex",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\hook-entry.mjs\" --host codex",
            "timeout": 2,
            "statusMessage": "Recording bounded Agent Coach outcome"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-entry.mjs\" --host codex",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\hook-entry.mjs\" --host codex",
            "timeout": 3,
            "additionalContextLimit": 1200,
            "statusMessage": "Completing Agent Coach trace"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/hook-entry.mjs\" --host codex",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\hook-entry.mjs\" --host codex",
            "timeout": 2,
            "statusMessage": "Closing Agent Coach session"
          }
        ]
      }
    ]
  }
}
