{
  "name": "agent-coach",
  "version": "0.1.0",
  "description": "Local-first, agent-neutral coaching and governed-memory control plane",
  "type": "module",
  "private": false,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "agent-coach": "./dist/cli.js",
    "agent-coach-mcp": "./dist/mcp/launcher.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm build:core && pnpm build:dashboard",
    "build:core": "tsc -p tsconfig.build.json",
    "build:dashboard": "pnpm --dir dashboard build && node -e \"require('node:fs').cpSync('dashboard/dist','dist/dashboard',{recursive:true})\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "demo": "node dist/cli.js demo",
    "test": "vitest run && pnpm --dir dashboard test",
    "test:core": "vitest run tests/core tests/server tests/mcp",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --dir dashboard typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2"
    }
  }
}
